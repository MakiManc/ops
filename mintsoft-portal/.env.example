# Copy to .dev.vars (git-ignored) for local runs. Never commit real values.
# In production these are Cloudflare secrets, not files.
#
# Supply exactly ONE of the three credential forms below. Check it with:
#   npm run check:credentials

# 1. The API user's login. The only form that survives a key expiring, so the only
#    one the scheduled sync can use. This is what production needs.
MINTSOFT_USERNAME=
MINTSOFT_PASSWORD=

# 2. A key already minted by POST /api/Auth. Mintsoft keys last 24 hours and this
#    cannot renew one, so it suits a one-off discovery run and nothing else.
# MINTSOFT_API_KEY=

# 3. The key is held outside the process and a proxy attaches the ms-apikey header
#    (a Claude Code environment API credential, for instance). Same 24-hour life.
# MINTSOFT_PROXY_AUTH=true

# Optional: pin discovery to one client/warehouse once Phase 0 identifies them.
MINTSOFT_CLIENT_ID=
MINTSOFT_WAREHOUSE_ID=
