{
  "name": "mintsoft-portal",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "discover": "node --experimental-strip-types --no-warnings scripts/discover.ts",
    "gen:types": "node --experimental-strip-types --no-warnings scripts/gen-types.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "db:migrate:local": "wrangler d1 migrations apply mintsoft-portal --local",
    "db:migrate:remote": "wrangler d1 migrations apply mintsoft-portal --remote",
    "seed": "node --experimental-strip-types --no-warnings scripts/seed.ts",
    "check:credentials": "node --experimental-strip-types --no-warnings scripts/check-credentials.ts",
    "spot-check": "node --experimental-strip-types --no-warnings scripts/spot-check.ts",
    "demo": "node --experimental-strip-types --no-warnings scripts/demo.ts",
    "demo:serve": "rm -rf .wrangler/demo && wrangler d1 migrations apply mintsoft-portal --local --persist-to .wrangler/demo && node --experimental-strip-types --no-warnings scripts/seed.ts --out seed/seed.sql && wrangler d1 execute mintsoft-portal --local --persist-to .wrangler/demo --file seed/seed.sql && wrangler d1 execute mintsoft-portal --local --persist-to .wrangler/demo --file seed/demo.sql && npm run build && wrangler pages dev dist --persist-to .wrangler/demo --local-protocol https --port 8788"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.1"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
